{
  "listen": ":8080",
  "admin_listen": "127.0.0.1:9090",
  "upstreams": [
    "http://127.0.0.1:9001",
    "http://127.0.0.1:9002",
    "http://127.0.0.1:9003"
  ],
  "rate_limit": {
    "algorithm": "token_bucket",
    "requests": 5,
    "per": "1s",
    "burst": 10,
    "key_by": "header:X-API-Key",
    "trust_forwarded": false
  },
  "health_check": {
    "path": "/healthz",
    "interval": "3s",
    "timeout": "1s"
  },
  "shutdown_timeout": "10s",
  "demo_endpoints": true
}
